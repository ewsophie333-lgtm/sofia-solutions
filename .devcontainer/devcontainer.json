{
  "name": "Sofia Solutions - ASIX Dev Environment",
  // Cambiamos compose por una imagen universal que ya tiene Node.js y herramientas
  "image": "://microsoft.com",
  "features": {
    // Esto te da el comando 'docker' y 'docker compose' en la terminal
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest"
    }
  },
  "forwardPorts": [
    8000,
    8001,
    3000,
    5556
  ],
  "portsAttributes": {
    "8000": { "label": "Web Pública (Frontend)", "onAutoForward": "notify" },
    "8001": { "label": "API Backend", "onAutoForward": "ignore" },
    "3000": { "label": "Grafana SOC", "onAutoForward": "notify" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-azuretools.vscode-docker",
        "ms-vscode.vscode-typescript-next",
        "prisma.prisma",
        "esbenp.prettier-vscode"
      ]
    }
  },
  // Aquí sí tiene sentido tu mensaje original
  "postCreateCommand": "npm install && echo 'Entorno listo. Usa docker compose up -d para arrancar.'"
}
