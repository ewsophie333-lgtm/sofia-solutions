{
  "name": "Sofia Solutions - ASIX Dev Environment",
  "image": "://microsoft.com",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest"
    }
  },
  "forwardPorts": [
    8000,
    8001,
    3000,
    5556,
    5678
  ],
  "portsAttributes": {
    "8000": {
      "label": "Web Pública (Frontend)",
      "onAutoForward": "notify"
    },
    "8001": {
      "label": "API Backend",
      "onAutoForward": "ignore"
    },
    "3000": {
      "label": "Grafana SOC",
      "onAutoForward": "notify"
    },
    "5556": {
      "label": "Prisma Studio",
      "onAutoForward": "notify"
    },
    "5678": {
      "label": "n8n Workflows",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-azuretools.vscode-docker",
        "ms-vscode.vscode-typescript-next",
        "prisma.prisma",
        "esbenp.prettier-vscode"
      ]
    }
  },
  "postCreateCommand": "echo 'Entorno listo. Usa docker compose up -d para arrancar.'"
}
